  "question": "Does one fixed same-frame RF/YOLO box-corroboration rule reduce erroneous emissions or recover lower-ranked RF ball observations without concealing lost correct observations?",
  "fixed_rule": {
    "arm": "rfdetr_yolo_box_corroborated_top_one",
    "rf_candidates": "all_existing_exported_sports_ball_candidates",
    "yolo_candidates": "all_existing_exported_sports_ball_candidates",
    "rf_confidence_floor_inclusive": 0.01,
    "yolo_confidence_floor_inclusive": 0.01,
    "additional_candidate_cap": null,
    "existing_detector_postprocessing_preserved": true,
    "same_source_frame_only": true,
    "support_predicate": "at_least_one_yolo_box_with_iou_greater_than_or_equal_to_threshold",
    "iou_threshold_inclusive": 0.5,
    "iou_arithmetic": "binary64; source xyxy boxes; intersection widths/heights max(0,min(maxima)-max(minima)); no +1; union=(area_rf+area_yolo)-intersection; iou=intersection/union; no comparison tolerance",
    "invalid_geometry_or_provenance": "fail_entire_authorized_comparison_closed_for_nonfinite_invalid_boxes_nonpositive_union_missing_bindings_or_misalignment; preserve_failure_evidence; no_silent_candidate_dropping_scientific_abstention_or_valid_partial_completion",
    "selection_order": ["original_rf_confidence_descending", "original_rf_candidate_index_ascending"],
    "no_support_behavior": "no_accepted_observation",
    "no_support_is_visibility_label": false,
    "output_geometry": "unchanged_original_rf_center_and_box",
    "output_confidence": "unchanged_original_rf_confidence_not_calibrated_probability",
    "multiple_support_reward": false,
    "score_or_coordinate_fusion": false,
    "deduplication": false,
    "temporal_state": false,
    "startup_and_reacquisition": "immediate_same_frame_rule_no_warmup",
    "loss": "immediate_missing_when_no_supported_candidate",
    "interpolation_or_extrapolation": false,
    "future_frames": false,
    "parameter_sweep_or_posthoc_tuning": false
  },
